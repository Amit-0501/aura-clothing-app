import { useEffect } from 'react'
import { useCart } from '../context/CartContext'

// ── Icons ─────────────────────────────────────────
function TrashIcon() {
  return (
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">
      <polyline points="3 6 5 6 21 6" />
      <path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a1 1 0 011-1h4a1 1 0 011 1v2" />
    </svg>
  )
}

function CloseIcon() {
  return (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
      <path d="M18 6L6 18M6 6l12 12" />
    </svg>
  )
}

// ── Cart line-item ────────────────────────────────
function CartItem({ item, onUpdateQty, onRemove }) {
  return (
    <div className="flex gap-4 py-5 border-b border-[#1c1c1c] last:border-0">
      {/* Thumbnail */}
      <div className="w-[72px] h-[90px] flex-shrink-0 bg-[#1a1a1a] overflow-hidden">
        <img src={item.image} alt={item.name} className="w-full h-full object-cover" />
      </div>

      {/* Details */}
      <div className="flex-1 min-w-0">
        <p className="text-[9px] tracking-[0.3em] text-[#555] uppercase mb-1">{item.category}</p>
        <h4 className="text-[13px] font-light text-[#e0e0e0] truncate mb-0.5">{item.name}</h4>
        <p className="text-[11px] text-[#555] mb-3">
          Size: {item.size}
        </p>

        <div className="flex items-center justify-between">
          {/* Qty stepper */}
          <div className="flex items-center border border-[#252525]">
            <button
              onClick={() => onUpdateQty(item.key, item.qty - 1)}
              aria-label="Decrease quantity"
              className="w-7 h-7 flex items-center justify-center text-[#666] hover:text-[#f5f5f5] transition-colors text-base"
            >
              −
            </button>
            <span className="w-7 text-center text-[12px] text-[#e0e0e0]">{item.qty}</span>
            <button
              onClick={() => onUpdateQty(item.key, item.qty + 1)}
              aria-label="Increase quantity"
              className="w-7 h-7 flex items-center justify-center text-[#666] hover:text-[#f5f5f5] transition-colors text-base"
            >
              +
            </button>
          </div>

          <div className="flex items-center gap-3">
            <p className="text-[13px] text-[#e0e0e0]">
              \${(item.price * item.qty).toFixed(2)}
            </p>
            <button
              onClick={() => onRemove(item.key)}
              aria-label={`Remove ${item.name}`}
              className="text-[#3a3a3a] hover:text-[#888] transition-colors"
            >
              <TrashIcon />
            </button>
          </div>
        </div>
      </div>
    </div>
  )
}

// ── Cart Drawer ───────────────────────────────────
export default function CartDrawer({ isOpen, onClose }) {
  const { cartItems, removeFromCart, updateQty, subtotal, itemCount } = useCart()

  // Lock body scroll when open
  useEffect(() => {
    if (isOpen) document.body.style.overflow = 'hidden'
    else document.body.style.overflow = ''
    return () => { document.body.style.overflow = '' }
  }, [isOpen])

  // Close on Escape
  useEffect(() => {
    if (!isOpen) return
    const onKey = (e) => { if (e.key === 'Escape') onClose() }
    window.addEventListener('keydown', onKey)
    return () => window.removeEventListener('keydown', onKey)
  }, [isOpen, onClose])

  const shippingRemaining = Math.max(0, 150 - subtotal)

  return (
    <>
      {/* ── Backdrop ─────────────────────────────── */}
      <div
        className={`fixed inset-0 z-50 bg-[#0a0a0a]/70 backdrop-blur-sm transition-opacity duration-300 ${isOpen ? 'opacity-100' : 'opacity-0 pointer-events-none'}`}
        onClick={onClose}
        aria-hidden="true"
      />

      {/* ── Drawer panel ─────────────────────────── */}
      <aside
        role="dialog"
        aria-label="Shopping bag"
        aria-modal="true"
        className={`fixed top-0 right-0 h-full z-50 w-full max-w-[380px] bg-[#0d0d0d] border-l border-[#1c1c1c] flex flex-col transition-drawer ${isOpen ? 'translate-x-0' : 'translate-x-full'}`}
      >
        {/* ── Header ───────────────────────────── */}
        <div className="flex items-center justify-between px-6 py-5 border-b border-[#1c1c1c]">
          <div>
            <h2 className="text-[12px] tracking-[0.35em] uppercase text-[#f5f5f5]">Your Bag</h2>
            {itemCount > 0 && (
              <p className="text-[10px] text-[#555] tracking-wider mt-0.5">
                {itemCount} item{itemCount !== 1 ? 's' : ''}
              </p>
            )}
          </div>
          <button
            onClick={onClose}
            aria-label="Close shopping bag"
            className="text-[#555] hover:text-[#f5f5f5] transition-colors"
          >
            <CloseIcon />
          </button>
        </div>

        {/* ── Free shipping progress ───────────── */}
        {subtotal > 0 && (
          <div className="px-6 py-3 border-b border-[#1c1c1c] bg-[#0f0f0f]">
            {shippingRemaining > 0 ? (
              <p className="text-[10px] text-[#666] tracking-wide">
                Add{' '}
                <span className="text-[#d4c5a9]">\${shippingRemaining.toFixed(2)}</span>
                {' '}more for free shipping
              </p>
            ) : (
              <p className="text-[10px] text-[#d4c5a9] tracking-wide">✓ You've unlocked free shipping</p>
            )}
            <div className="mt-2 h-[2px] bg-[#1c1c1c] rounded-full overflow-hidden">
              <div
                className="h-full bg-[#d4c5a9] transition-all duration-500"
                style={{ width: `${Math.min(100, (subtotal / 150) * 100)}%` }}
              />
            </div>
          </div>
        )}

        {/* ── Items list ───────────────────────── */}
        <div className="flex-1 overflow-y-auto px-6">
          {cartItems.length === 0 ? (
            <div className="flex flex-col items-center justify-center h-full py-20 text-center">
              <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="#2a2a2a" strokeWidth="1" className="mb-5">
                <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" />
                <line x1="3" y1="6" x2="21" y2="6" />
                <path d="M16 10a4 4 0 01-8 0" />
              </svg>
              <p className="text-[#444] text-[11px] tracking-[0.3em] uppercase mb-2">Your bag is empty</p>
              <p className="text-[#333] text-[11px]">Add items to get started</p>
            </div>
          ) : (
            <div>
              {cartItems.map((item) => (
                <CartItem
                  key={item.key}
                  item={item}
                  onUpdateQty={updateQty}
                  onRemove={removeFromCart}
                />
              ))}
            </div>
          )}
        </div>

        {/* ── Footer / Checkout ────────────────── */}
        {cartItems.length > 0 && (
          <div className="border-t border-[#1c1c1c] px-6 py-6 space-y-5 bg-[#0d0d0d]">
            {/* Subtotal */}
            <div className="flex items-baseline justify-between">
              <span className="text-[10px] tracking-[0.3em] text-[#666] uppercase">Subtotal</span>
              <span className="text-[20px] font-light text-[#f5f5f5]">
                \${subtotal.toFixed(2)}
              </span>
            </div>

            <p className="text-[10px] text-[#3a3a3a] tracking-wide">
              Taxes & shipping calculated at checkout
            </p>

            {/* Checkout button */}
            <button className="w-full bg-[#f5f5f5] text-[#0a0a0a] py-4 text-[10px] tracking-[0.3em] uppercase hover:bg-[#d4c5a9] transition-colors duration-300">
              Checkout
            </button>

            {/* Continue shopping */}
            <button
              onClick={onClose}
              className="w-full text-[#444] py-2 text-[10px] tracking-[0.25em] uppercase hover:text-[#888] transition-colors"
            >
              Continue Shopping
            </button>
          </div>
        )}
      </aside>
    </>
  )
}
